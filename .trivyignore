# whenever the node:24-trixie-slim tag updates.
CVE-2026-12151  # undici
CVE-2026-13149  # brace-expansion
CVE-2026-14257  # brace-expansion
CVE-2026-59873  # tar
CVE-2026-59874  # tar
CVE-2026-69152  # brace-expansion
CVE-2026-69192  # ip-address
CVE-2026-73566  # tar (issue #466; latest published npm, 12.0.2, still bundles 7.5.19)

