#!/bin/sh
set -eu

real_pg_dump="${DUNE_REAL_PG_DUMP:-/usr/bin/pg_dump}"

# Funcom's patch validator replays a schema-only dump into a database that only
# contains the game schema. Keep Console-owned schemas out of that temporary
# validation dump, while leaving ordinary backup/data dumps complete.
for argument in "$@"; do
  if [ "$argument" = "--schema-only" ]; then
    exec "$real_pg_dump" --exclude-schema='console_*' --exclude-schema='dune_runtime' "$@"
  fi
done

exec "$real_pg_dump" "$@"
