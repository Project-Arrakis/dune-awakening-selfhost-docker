{
  "uid": "dune-game-server-health",
  "title": "Dune — Game Server Health",
  "tags": ["dune", "noc"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "title": "Players Online",
      "type": "stat",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 3},
      "targets": [{"expr": "dune_players_online", "legendFormat": "Online"}]
    },
    {
      "title": "CPU Usage",
      "type": "gauge",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 3},
      "targets": [{"expr": "100 * (1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])))", "legendFormat": "CPU %"}],
      "fieldConfig": {
        "defaults": {"unit": "percent", "min": 0, "max": 100, "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "orange", "value": 70}, {"color": "red", "value": 90}]}}
      }
    },
    {
      "title": "Memory Usage",
      "type": "gauge",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 3},
      "targets": [{"expr": "100 * (1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes))", "legendFormat": "Memory %"}],
      "fieldConfig": {
        "defaults": {"unit": "percent", "min": 0, "max": 100, "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "orange", "value": 80}, {"color": "red", "value": 95}]}}
      }
    },
    {
      "title": "Disk Usage",
      "type": "gauge",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 3},
      "targets": [{"expr": "100 * (1 - (node_filesystem_avail_bytes{fstype!=\"tmpfs\"} / node_filesystem_size_bytes{fstype!=\"tmpfs\"}))", "legendFormat": "Disk %"}],
      "fieldConfig": {
        "defaults": {"unit": "percent", "min": 0, "max": 100, "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "orange", "value": 80}, {"color": "red", "value": 95}]}}
      }
    },
    {
      "title": "CPU/Memory/Disk — 24h",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 3, "w": 24, "h": 8},
      "targets": [
        {"expr": "100 * (1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])))", "legendFormat": "CPU %"},
        {"expr": "100 * (1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes))", "legendFormat": "Memory %"},
        {"expr": "100 * (1 - (node_filesystem_avail_bytes{fstype!=\"tmpfs\"} / node_filesystem_size_bytes{fstype!=\"tmpfs\"}))", "legendFormat": "Disk %"}
      ]
    },
    {
      "title": "Container Health",
      "type": "stat",
      "gridPos": {"x": 0, "y": 11, "w": 6, "h": 3},
      "targets": [{"expr": "count(up{job=~\"dune-.*\"} == 1)", "legendFormat": "Running"}, {"expr": "count(up{job=~\"dune-.*\"})", "legendFormat": "Total"}],
      "fieldConfig": {"defaults": {"thresholds": {"steps": [{"color": "green", "value": null}, {"color": "red", "value": 0}]}}}
    },
    {
      "title": "Active Alerts",
      "type": "stat",
      "gridPos": {"x": 6, "y": 11, "w": 6, "h": 3},
      "targets": [{"expr": "count(ALERTS{alertstate=\"firing\"})", "legendFormat": "Firing"}],
      "fieldConfig": {"defaults": {"thresholds": {"steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}, {"color": "red", "value": 5}]}}}
    },
    {
      "title": "Postgres Connections",
      "type": "gauge",
      "gridPos": {"x": 12, "y": 11, "w": 6, "h": 3},
      "targets": [{"expr": "100 * (pg_stat_activity_count / pg_settings_max_connections)", "legendFormat": "PG Conn %"}],
      "fieldConfig": {"defaults": {"unit": "percent", "max": 100, "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "orange", "value": 70}, {"color": "red", "value": 90}]}}}
    },
    {
      "title": "Postgres Cache Hit Ratio",
      "type": "gauge",
      "gridPos": {"x": 18, "y": 11, "w": 6, "h": 3},
      "targets": [{"expr": "100 * (pg_stat_database_blks_hit{datname=\"dune\"} / (pg_stat_database_blks_hit{datname=\"dune\"} + pg_stat_database_blks_read{datname=\"dune\"}))", "legendFormat": "Cache Hit %"}],
      "fieldConfig": {"defaults": {"unit": "percent", "max": 100, "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "orange", "value": 95}, {"color": "red", "value": 90}]}}}
    },
    {
      "title": "Alert List",
      "type": "alertlist",
      "gridPos": {"x": 0, "y": 14, "w": 24, "h": 6},
      "options": {"showOptions": "current", "sortOrder": 1, "alertName": "", "dashboardAlerts": false, "stateFilter": {"firing": true, "pending": true}}
    }
  ]
}
