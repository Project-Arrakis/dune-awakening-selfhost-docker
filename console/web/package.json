{
  "name": "redblink-dune-docker-console-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "build:preview": "tsc -b && node scripts/build-preview.mjs",
    "test:preview": "node browser-tests/preview.mjs",
    "check:preview-seo": "node --test scripts/preview-seo.test.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "check:i18n": "node --test scripts/translation-catalog.test.mjs && node scripts/translation-catalog.mjs check",
    "list:i18n": "node scripts/translation-catalog.mjs list",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/mocker": "^5.1.0",
    "lucide-react": "^1.68.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.7.3",
    "vite": "^8.3.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^30.1.3",
    "vitest": "^5.0.4"
  }
}
